<?php

$config = [];

// The exact OIDC issuer. Discovery is loaded from
// {issuer}/.well-known/openid-configuration. HTTPS is required.
$config['oidc_url'] = 'https://id.example.com/realms/example';

// Registered client credentials. A secret may be blank for a public client,
// although a confidential web client is recommended for Roundcube.
$config['oidc_client'] = 'roundcube';
$config['oidc_secret'] = '';

// Must exactly match a redirect URI registered at the provider. An explicit
// value avoids Host-header and reverse-proxy ambiguity.
$config['oidc_redirect_uri'] = 'https://mail.example.com/?_task=login&_action=plugin.oidc';

// Space-separated string or array. "openid" is always added.
$config['oidc_scope'] = ['openid', 'email', 'profile'];

// Claim used as the IMAP username. Prefer a provider-issued, verified email or
// another immutable claim mapped to the local mailbox account.
$config['oidc_field_uid'] = 'email';
$config['oidc_require_email_verified'] = true;

// Fetch UserInfo after validating the ID token. Its "sub" must match the token.
$config['oidc_use_userinfo'] = true;

// Optional dynamic IMAP host claim. It is disabled by default. If enabled,
// every accepted value must be listed exactly in oidc_allowed_imap_hosts to
// prevent an asserted host from receiving credentials.
$config['oidc_field_server'] = '';
$config['oidc_allowed_imap_hosts'] = [];

// Only these ID-token algorithms are accepted. The bundled client supports
// RSA (RS*/PS*) and HMAC (HS*) algorithms; asymmetric RS256 is the safe default.
$config['oidc_allowed_signing_algorithms'] = ['RS256'];

// Discovery endpoints are restricted to the issuer host by default. List any
// additional exact hosts used by a trusted provider (for example, a separate
// CDN host for JWKS). Redirects between endpoints are never followed.
$config['oidc_allowed_endpoint_hosts'] = [];

// Keep false for internet-hosted providers. Enable only for an intentionally
// private enterprise IdP; this relaxes SSRF protection for allowlisted hosts.
$config['oidc_allow_private_endpoint_ips'] = false;

// Network and token timing limits.
$config['oidc_timeout'] = 10;
$config['oidc_clock_skew'] = 60;
$config['oidc_password_prompt_ttl'] = 300;

// Required for credentials stored in the Roundcube database. Generate once
// with: openssl rand -base64 32
// Keep this key outside the database, restrict access to config.inc.php, back it
// up securely, and never rotate it without first deleting saved credentials.
$config['oidc_password_encryption_key'] = 'REPLACE_WITH_BASE64_32_BYTE_KEY';

// Login button text.
$config['oidc_button_label'] = 'Login with Single-Sign On';

// Passwordless passkey login. Passkeys are enrolled from Settings after an SSO
// login has saved the encrypted mailbox password. These values are explicit so
// neither the Host header nor a reverse proxy can change the WebAuthn scope.
$config['oidc_passkeys_enabled'] = true;
$config['oidc_passkey_origin'] = 'https://mail.example.com';
$config['oidc_passkey_rp_id'] = 'mail.example.com';
$config['oidc_passkey_rp_name'] = 'Example Mail';

// Optional RP-Initiated Logout. Leave blank for local-only logout. If set, the
// exact HTTPS URI must also be registered with the provider.
// Example: https://mail.example.com/?_task=login&_action=plugin.oidc-logout
$config['oidc_post_logout_redirect_uri'] = '';

{
    "name": "imrasalghul/oidc-cube",
    "type": "roundcube-plugin",
    "description": "Secure OpenID Connect login plugin for Roundcube 1.7",
    "license": "MIT",
    "homepage": "https://alghul.com",
    "authors": [
        {
            "name": "Ra's al Ghul",
            "homepage": "https://alghul.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "roundcube/plugin-installer": "^0.3.11",
        "jumbojett/openid-connect-php": "^1.0.2",
        "phpseclib/phpseclib": "^3.0.56",
        "web-auth/webauthn-lib": "^5.3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-mbstring": "Required by Roundcube"
    },
    "config": {
        "allow-plugins": {
            "roundcube/plugin-installer": true
        }
    }
}
